# Copy to .env (never commit it). Loaded by systemd via EnvironmentFile.

# Must be a loopback address. The app refuses to start on anything else.
HOST=127.0.0.1
PORT=3100

DB_PATH=/srv/portal/data/portal.db

# Cloudflare Access: the team domain (without https://) and the application's AUD tag.
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
ACCESS_AUD=

# The office Access application's AUD tag (office.swaletutoring.co.uk). Leave blank to keep
# the office API switched off. Read it from the login redirect's kid= parameter, not the app ID.
OFFICE_ACCESS_AUD=

# Pupil documents and other uploads. Outside the repo; in the backup plan.
FILES_DIR=/srv/portal/files

# Shown as the one-tap "phone the DSL" link.
DSL_PHONE="01795 608506"
